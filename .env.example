# ==============================================================================
# ZAIRA FURNISHING — Production Environment Configuration Template
# Copy this file to .env.local for local development.
# ==============================================================================

# ─── 1. Cloudflare D1 Relational Database ───
# In production on Cloudflare Pages / Workers or via Cloudflare API:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# In local development without Cloudflare credentials, the database layer automatically
# defaults to local SQLite at data/zaira.db using zero-dependency node:sqlite.

# ─── 2. Cloudflare R2 Media & Image Storage ───
# S3-compatible credentials for Cloudflare R2 image upload pipeline
# (Supports both CLOUDFLARE_R2_* and R2_* variable prefixes)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=zaira-furnishing-media
CLOUDFLARE_R2_PUBLIC_URL=
NEXT_PUBLIC_CLOUDFLARE_R2_URL=

# ─── 3. Application & Security ───
# Base website URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret key for signing sessions and JWTs (generate using `openssl rand -base64 32`)
AUTH_SECRET=

# Master secret / password for /admin/login console (Atelier Admin portal)
ADMIN_SECRET_KEY=

# Contact & Atelier Notification Webhooks (optional)
ADMIN_NOTIFICATION_EMAIL=concierge@zairafurnishing.com
WHATSAPP_CONCIERGE_NUMBER=+917947415666
